{
  "name": "corduroy",
  "version": "0.0.1",
  "private": true,
  "description": "Ski resort operations and mountain simulator (three.js WebGPU)",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "electron .",
    "typecheck": "tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:quick": "npm run typecheck && npm run test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@preact/signals": "2.11.4",
    "preact": "11.2.0",
    "three": "0.187.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "electron": "45.3.1",
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
